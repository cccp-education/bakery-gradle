                </ul>
                <!-- Theme Switcher moved outside the ul for simpler flexbox calculation -->
                <div class="nav-item dropdown theme-switcher-container ms-lg-3">
                    <button class="btn btn-outline-secondary dropdown-toggle theme-dropdown-btn"
                            type="button"
                            id="themeDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Sélectionner le thème de l'interface">
                        <i class="bi bi-sun"></i>
                        <span id="current-theme" class="visually-hidden">Clair</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="themeDropdown">
                        <li><button class="dropdown-item theme-option"
                                    type="button"
                                    data-theme="light">
                            <i class="bi bi-sun me-2"></i>Clair
                        </button></li>
                        <li><button class="dropdown-item theme-option" type="button" data-theme="dark">
                            <i class="bi bi-moon me-2"></i>Sombre
                        </button></li>
                        <li><button class="dropdown-item theme-option" type="button" data-theme="high-contrast">
                            <i class="bi bi-circle-half me-2"></i>Contraste élevé
                        </button></li>
                    </ul>
                </div>
<!-- che-i18n:lang-switcher:start -->
                <div class="nav-item dropdown lang-switcher-container ms-lg-2">
                    <button class="btn btn-outline-secondary dropdown-toggle lang-dropdown-btn"
                            type="button"
                            id="langDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Sélectionner la langue">
                        <span class="me-1">🇫🇷</span>
                        <span class="ms-1">FR</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'en/' + content.uri : content.rootpath + 'en/index.html'}" data-lang="en">
                            <span class="lang-flag me-2" aria-hidden="true">🇬🇧</span>English
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'zh/' + content.uri : content.rootpath + 'zh/index.html'}" data-lang="zh">
                            <span class="lang-flag me-2" aria-hidden="true">🇨🇳</span>中文
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'hi/' + content.uri : content.rootpath + 'hi/index.html'}" data-lang="hi">
                            <span class="lang-flag me-2" aria-hidden="true">🇮🇳</span>हिन्दी
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'es/' + content.uri : content.rootpath + 'es/index.html'}" data-lang="es">
                            <span class="lang-flag me-2" aria-hidden="true">🇪🇸</span>Español
                        </a></li>
                        <li><a class="dropdown-item lang-option active" th:href="${content.uri != null ? content.uri.substring(content.uri.lastIndexOf('/') + 1) : content.rootpath + 'index.html'}" data-lang="fr">
                            <span class="lang-flag me-2" aria-hidden="true">🇫🇷</span>Français
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'ar/' + content.uri : content.rootpath + 'ar/index.html'}" data-lang="ar">
                            <span class="lang-flag me-2" aria-hidden="true">🇸🇦</span>العربية
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'bn/' + content.uri : content.rootpath + 'bn/index.html'}" data-lang="bn">
                            <span class="lang-flag me-2" aria-hidden="true">🇧🇩</span>বাংলা
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'pt/' + content.uri : content.rootpath + 'pt/index.html'}" data-lang="pt">
                            <span class="lang-flag me-2" aria-hidden="true">🇵🇹</span>Português
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'ru/' + content.uri : content.rootpath + 'ru/index.html'}" data-lang="ru">
                            <span class="lang-flag me-2" aria-hidden="true">🇷🇺</span>Русский
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'ur/' + content.uri : content.rootpath + 'ur/index.html'}" data-lang="ur">
                            <span class="lang-flag me-2" aria-hidden="true">🇵🇰</span>اردو
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'it/' + content.uri : content.rootpath + 'it/index.html'}" data-lang="it">
                            <span class="lang-flag me-2" aria-hidden="true">🇮🇹</span>Italiano
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'nl/' + content.uri : content.rootpath + 'nl/index.html'}" data-lang="nl">
                            <span class="lang-flag me-2" aria-hidden="true">🇳🇱</span>Nederlands
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'de/' + content.uri : content.rootpath + 'de/index.html'}" data-lang="de">
                            <span class="lang-flag me-2" aria-hidden="true">🇩🇪</span>Deutsch
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'el/' + content.uri : content.rootpath + 'el/index.html'}" data-lang="el">
                            <span class="lang-flag me-2" aria-hidden="true">🇬🇷</span>Ελληνικά
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'tr/' + content.uri : content.rootpath + 'tr/index.html'}" data-lang="tr">
                            <span class="lang-flag me-2" aria-hidden="true">🇹🇷</span>Türkçe
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'vi/' + content.uri : content.rootpath + 'vi/index.html'}" data-lang="vi">
                            <span class="lang-flag me-2" aria-hidden="true">🇻🇳</span>Tiếng Việt
                        </a></li>
                        <li><a class="dropdown-item lang-option" th:href="${content.uri != null ? content.rootpath + 'th/' + content.uri : content.rootpath + 'th/index.html'}" data-lang="th">
                            <span class="lang-flag me-2" aria-hidden="true">🇹🇭</span>ไทย
                        </a></li>
                    </ul>
                </div>
<!-- che-i18n:lang-switcher:end -->
            </div>
        </div>
    </nav>
</div>
