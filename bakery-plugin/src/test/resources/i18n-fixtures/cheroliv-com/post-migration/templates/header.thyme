<!DOCTYPE html SYSTEM "http://www.thymeleaf.org/dtd/xhtml1-transitional-thymeleaf-4.dtd">
<html lang="fr">
<head th:fragment="head(canonOverride)">
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title th:text="${!#strings.isEmpty(content.title)} ? ${content.title} + ' — Cheroliv' : 'Cheroliv - Développeur Formateur | Ingénierie Pédagogique'">Cheroliv - Développeur Formateur | Ingénierie Pédagogique</title>

    <th:block th:with="canonUri=(${canonOverride != null} ? ${canonOverride} : (${content.uri != null and content.uri != 'index.html'} ? ${content.uri} : '')),
                       pageDesc=${#strings.defaultString(content.summary, #strings.defaultString(content.description, 'Développeur formateur spécialisé en ingénierie pédagogique. Conception et développement de solutions e-learning innovantes.'))},
                       ogImage=${(content.type != null and content.type == 'post' and content.uri != null and content.uri != '')} ? ${'og-images/fr/' + #strings.replace(content.uri, '.html', '.png')} : 'og-images/fr/cheroliv-default.png'">
        <link rel="canonical" th:href="${config.site_host} + ${canonUri}"/>

        <!-- Hreflang alternates FR <-> EN -->
        <link rel="alternate" hreflang="fr" th:href="${config.site_host} + ${canonUri}"/>
        <link rel="alternate" hreflang="en" th:unless="${content.uri != null and #strings.startsWith(content.uri, 'blog/pilot-batch/')}" th:href="${config.site_host} + 'en/' + ${canonUri}"/>
        <link rel="alternate" hreflang="x-default" th:href="${config.site_host} + ${canonUri}"/>

        <!-- Open Graph -->
        <meta property="og:site_name" th:content="#{header.1}" content="Cheroliv"/>
        <meta property="og:title" th:content="${!#strings.isEmpty(content.title)} ? ${content.title} + ' — Cheroliv' : 'Cheroliv - Développeur Formateur | Ingénierie Pédagogique'"/>
        <meta property="og:description" th:content="${pageDesc}"/>
        <meta property="og:type" th:content="${content.type != null and content.type == 'post'} ? 'article' : 'website'"/>
        <meta property="og:url" th:content="${config.site_host} + ${canonUri}"/>
        <meta property="og:locale" th:content="#{header.2}" content="fr_FR"/>
        <meta property="og:image" th:content="${config.site_host} + ${ogImage}"/>

        <!-- Twitter Card -->
        <meta name="twitter:card" th:content="#{header.3}" content="summary"/>
        <meta name="twitter:title" th:content="${!#strings.isEmpty(content.title)} ? ${content.title} + ' — Cheroliv' : 'Cheroliv - Développeur Formateur | Ingénierie Pédagogique'"/>
        <meta name="twitter:description" th:content="${pageDesc}"/>
        <meta name="twitter:image" th:content="${config.site_host} + ${ogImage}"/>
        <meta name="description" th:content="${pageDesc}"/>
    </th:block>

    <!-- RSS feed autodiscovery -->
    <link rel="alternate" type="application/rss+xml" th:title="#{header.4}" title="Cheroliv — Flux RSS" th:href="${config.site_host} + 'feed.xml'"/>

    <script th:inline="javascript">
        // IIFE to avoid polluting global scope
        (function() {
          try {
            const theme = localStorage.getItem('preferred-theme');
            if (theme) {
              document.documentElement.setAttribute('data-bs-theme', theme);
            }
          } catch (e) {
            // Reading from localStorage can fail in private browsing mode on some browsers
            console.warn('Could not set theme from localStorage', e);
          }
        })();
    </script>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet" integrity="sha384-Bk5cbLkZQ5raZ0+H2/+VbfYx3WpvxvQK4zqXZr7sYODuaX7bKXoSOnipQxkaS8sv" crossorigin="anonymous" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- intl-tel-input CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.10.1/build/css/intlTelInput.css" integrity="sha384-huckmaRY7yjByQizNg4/mcNFFWSCC1CCl6aFYN9cGKc7zuKh7+XNuoSpLwyEgCmk" crossorigin="anonymous">

    <!-- highlight.js: theme will be managed dynamically by script.js -->
    <link id="highlight-js-theme" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/default.min.css" integrity="sha384-4Y0nObtF3CbKnh+lpzmAVdAMtQXl+ganWiiv73RcGVdRdfVIya8Cao1C8ZsVRRDz" crossorigin="anonymous"
          th:href="@{https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/default.min.css}">

    <!-- Custom CSS -->
    <link th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/styles.css'" rel="stylesheet" />

    <!-- highlight.js: theme will be managed dynamically by script.js -->
    <link id="highlight-js-theme" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/default.min.css"
          th:href="@{https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/default.min.css}">

    <link th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/asciidoctor.css'" rel="stylesheet"/>



    <!-- Favicon -->
    <link th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')"
          rel="shortcut icon"
          th:href="${rootpath}+'img/cheroliv_logo_icon.png'"/>



    <!-- Meta tags pour SEO -->
    <meta name="author" th:content="#{header.1}" content="Cheroliv"/>

    <!-- Duplicate content mitigation: pilot-batch mirrors the main blog -->
    <meta name="robots" th:if="${content.uri != null and #strings.startsWith(content.uri, 'blog/pilot-batch/')}" th:content="#{header.6}" content="noindex, follow"/>

    <!-- Structured data: WebSite + Person -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://cheroliv.com/#website",
          "url": "https://cheroliv.com/",
          "name": "Cheroliv - Développeur Formateur | Ingénierie Pédagogique",
          "inLanguage": "fr",
          "publisher": { "@id": "https://cheroliv.com/#person" }
        },
        {
          "@type": "Person",
          "@id": "https://cheroliv.com/#person",
          "name": "Cheroliv",
          "url": "https://cheroliv.com/",
          "jobTitle": "Développeur Formateur | Ingénierie Pédagogique",
          "sameAs": [ "https://github.com/cheroliv" ]
        }
      ]
    }
    </script>
</head>
</html>